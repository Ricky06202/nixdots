{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/ricky/.config/opencode/INSTRUCTIONS.md"
  ],
  // Modelo local por defecto; usa local/spark-4b-think para tareas que
  // necesiten razonamiento. Ambos apuntan al alias spark-4b de llama.cpp.
  "model": "local/spark-4b",
  // Tareas cortas (titulos de sesion, resumenes): tambien local, $0.
  "small_model": "local/spark-4b",
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "tokens": 50000
    },
    "buffer": 20000
  },
  // llama.cpp sirve Spark-X2.6-4B en 127.0.0.1:8091. Iniciar con `local-ai chat`.
  // El servicio usa -ub 256; no subirlo a 512, puede colgar la GPU durante el prefill.
  "providers": {
    "local": {
      "name": "LocalSpark (RX 7600)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8091/v1"
      },
      "models": {
        // Mismo servidor y mismos pesos: solo cambia si razona antes de responder.
        "spark-4b": {
          "name": "Spark-X2.6 4B (rápido, sin pensar)",
          "modelID": "spark-4b",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "body": {
            "temperature": 0.7,
            "top_p": 0.95,
            "chat_template_kwargs": { "enable_thinking": false }
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "spark-4b-think": {
          "name": "Spark-X2.6 4B (razonando)",
          "modelID": "spark-4b",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "body": {
            "temperature": 0.7,
            "top_p": 0.95,
            "chat_template_kwargs": { "reasoning_effort": "high" }
          },
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  }
}
