#!/usr/bin/env python3
"""nini — asistente de terminal: Ollama local primero, DeepSeek como respaldo (v4 mini-opencode)."""
import json, os, re, sys, subprocess, urllib.request, urllib.error, time, uuid
from pathlib import Path

# ── Providers ──
DEEPSEEK_URL  = "https://api.deepseek.com/chat/completions"
DEEPSEEK_MODEL = "deepseek-chat"
OLLAMA_URL    = "http://127.0.0.1:11434/api/chat"
OLLAMA_TAGS   = "http://127.0.0.1:11434/api/tags"
OLLAMA_MODEL  = "qwen3:8b"
THINK_MODE    = True  # qwen3 razona antes de responder (más completo; ver --nothink)

API_KEY = Path.home() / ".config" / "nini" / "api.key"
HISTORY = Path.home() / ".config" / "nini" / "history.jsonl"
MAX_HIST = 20
MAX_STEPS = 100
MAX_DEV_STEPS = 100
MAX_READ_CHARS = 30000
MAX_CONVO_CHARS = 40000
PROVIDER = None

# ANSI
BOLD  = "\033[1m"
CYAN  = "\033[36m"
GREEN = "\033[32m"
RED   = "\033[31m"
DIM   = "\033[2m"
YELLOW = "\033[33m"
RESET = "\033[0m"

# ── Safety: destructive commands ─────────────────────────────────────────────
DESTRUCTIVE_PATTERNS = [
    (r"rm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\s+/", "rm -rf / detectado. Esto borra TODO el sistema."),
    (r"rm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\s+~", "rm -rf ~ detectado. Esto borra tu home."),
    (r"rm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\s+\*", "rm -rf * detectado. Esto borra todo en el directorio."),
    (r"dd\s+.*of=/dev/[sh]d", "dd a disco detectado. Puede sobrescribir datos permanentemente."),
    (r"mkfs\.", "Formateo de disco detectado. Esto borra todo el contenido."),
    (r":\(\)\s*\{\s*:\|:", "Fork bomb detectado. Esto congelaría el sistema."),
    (r"chmod\s+-R\s+777\s+/", "chmod 777 en / detectado. Esto rompe permisos del sistema."),
    (r"chown\s+-R\s+.*\s+/", "chown en / detectado. Esto cambia ownership del sistema."),
    (r"> /dev/sd", "Sobrescritura de disco detectada."),
    (r"shutdown", "Comando de apagado detectado."),
    (r"reboot", "Comando de reinicio detectado."),
    (r"poweroff", "Comando de apagado detectado."),
    (r"init\s+0", "Cambio a runlevel 0 (apagado)."),
    (r"systemctl\s+stop\s+(multi-user|graphical|default)", "Deteniendo target del sistema."),
]

# ── Safety: heavy commands that can OOM the system ───────────────────────────
HEAVY_PATTERNS = [
    ("speedtest", "Speedtest descarga archivos grandes. Usa: curl -s https://ifconfig.me"),
    ("cloudflare.com/__down", "Cloudflare speed test descarga 100MB+. Puede causar OOM."),
    ("curl.*bytes=[0-9]{7,}", "Descarga de archivo muy grande detectada."),
]

MIN_FREE_RAM_MB = 500
YES_MODE = True

# Apps graficas que nini NO debe ejecutar (el usuario las abre el mismo)
DENY_RUN = {"code", "codium", "code-insiders", "gvim", "sublime_text", "zed"}

def get_free_ram_mb():
    """Get free RAM in MB."""
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    return int(line.split()[1]) // 1024
    except Exception:
        pass
    return 9999  # assume OK if can't read

def check_heavy_command(cmd):
    """Check if command is too heavy for the system. Returns (safe, warning)."""
    import re
    cmd_lower = cmd.lower()

    # Check destructive patterns first (always block)
    for pattern, warning in DESTRUCTIVE_PATTERNS:
        if re.search(pattern, cmd, re.IGNORECASE):
            return False, f"DESTRUCTIVO: {warning}"

    # Check heavy patterns
    for pattern, warning in HEAVY_PATTERNS:
        if warning and re.search(pattern, cmd_lower):
            return False, warning

    # Check for curl/wget downloading large files (no --limit-rate)
    if ("curl" in cmd_lower or "wget" in cmd_lower) and "--limit-rate" not in cmd_lower:
        if any(x in cmd_lower for x in ["__down", "bytes=", "large", "100m", "250m"]):
            return False, "Descarga grande sin limite de velocidad. Puede causar OOM."

    # Check free RAM
    free_mb = get_free_ram_mb()
    if free_mb < MIN_FREE_RAM_MB:
        return False, f"RAM libre baja: {free_mb}MB (mínimo {MIN_FREE_RAM_MB}MB). Puede causar OOM."

    return True, None

# ── System context ────────────────────────────────────────────────────────────
def get_system_context():
    ctx = []
    try:
        r = subprocess.run(["df", "-h", "--output=target,size,used,avail,pct", "/",
                            "/nix", "/home"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            ctx.append("Disk:\n" + r.stdout.strip())
    except Exception: pass
    try:
        r = subprocess.run(["free", "-h"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            ctx.append("RAM:\n" + r.stdout.strip())
    except Exception: pass
    try:
        with open("/proc/loadavg") as f:
            ctx.append("Load: " + f.read().strip())
    except Exception: pass
    try:
        r = subprocess.run(["nmcli", "-t", "-f", "active,ssid,signal", "dev", "wifi"],
                           capture_output=True, text=True, timeout=5)
        lines = [l for l in r.stdout.strip().split("\n") if l.startswith("yes")]
        if lines:
            ctx.append("WiFi: " + lines[0])
    except Exception: pass
    try:
        r = subprocess.run(["systemctl", "list-units", "--type=service", "--state=failed",
                            "--no-pager", "--no-legend"], capture_output=True, text=True, timeout=5)
        if r.stdout.strip():
            ctx.append("FAILED services:\n" + r.stdout.strip())
    except Exception: pass
    try:
        r = subprocess.run(["bluetoothctl", "info"], capture_output=True, text=True, timeout=5)
        if "Connected: yes" in r.stdout:
            for line in r.stdout.split("\n"):
                if "Name:" in line:
                    ctx.append("BT connected: " + line.split("Name:")[1].strip())
                    break
    except Exception: pass
    return "\n\n".join(ctx) if ctx else "No system context available."


# ── History ───────────────────────────────────────────────────────────────────
def load_history(n=5):
    if not HISTORY.exists():
        return []
    lines = HISTORY.read_text().strip().split("\n")
    entries = []
    for line in lines[-n:]:
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            pass
    return entries

def save_history(prompt, command, exit_code, output_preview=""):
    entry = {
        "id": str(uuid.uuid4())[:8],
        "ts": int(time.time()),
        "prompt": prompt,
        "command": command,
        "exit_code": exit_code,
        "output": output_preview[:200],
    }
    with open(HISTORY, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    lines = HISTORY.read_text().strip().split("\n")
    if len(lines) > MAX_HIST:
        HISTORY.write_text("\n".join(lines[-MAX_HIST:]) + "\n")

def format_history(ctx_entries):
    if not ctx_entries:
        return ""
    parts = ["Recent history (last commands):"]
    for e in ctx_entries:
        status = "OK" if e.get("exit_code", -1) == 0 else f"FAIL({e.get('exit_code')})"
        cmd = e.get("command", "?")
        if cmd:
            parts.append(f"- [{status}] {e.get('prompt')}: {cmd[:80]}")
    return "\n".join(parts)


# ── Detect mode ───────────────────────────────────────────────────────────────
def detect_mode(user_text):
    t = user_text.lower()
    if any(kw in t for kw in ["qué hace", "explica", "qué significa", "define",
                               "explain", "que hace", "q hace", "que significa"]):
        return "explain"
    if any(kw in t for kw in ["en ubuntu", "en debian", "en arch", "en fedora",
                               "en manjaro", "traduce a ubuntu", "traduce a debian",
                               "cómo sería en", "como seria en"]):
        return "translate"
    if any(kw in t for kw in ["nix", "nixos", "nixpkgs", "nix-env", "rebuild",
                               "configuration.nix", "flake"]):
        return "nixos"
    return "default"


# ── System prompt builder ────────────────────────────────────────────────────
BASE_PROMPT = (
    "Linux NixOS Hyprland. "
    "Available commands by category:\n"
    "System: ls, cat, grep, find, df, du, free, top, htop, ps, kill, pkill, pgrep, mkdir, cp, mv, rm, "
    "chmod, chown, touch, ln, tar, zip, unzip, wc, sort, uniq, head, tail, xargs, sed, awk, cut, tr, diff, file, stat, tree, uptime, lsblk, lscpu\n"
    "NixOS: nix, nix-env, nix-shell, nix profile, nix-store, nixos-rebuild, nix flake\n"
    "Hyprland: hyprctl, hyprpaper, hyprpicker, hyprlock, hypridle\n"
    "Audio: pactl, wpctl, playerctl, amixer\n"
    "Network: nmcli, bluetoothctl, ip, ss, ping, curl, wget, dig\n"
    "Systemd: systemctl, journalctl\n"
    "Dev: git, python3, node, cargo, rustc, gcc, make, Deno\n"
    "GUI: grim, slurp, wl-copy, wl-paste, notify-send, brightnessctl, wofi\n"
    "pacman DOES NOT EXIST here, use nix instead. "
)

def build_system_prompt(mode, system_ctx, history_ctx):
    parts = [BASE_PROMPT]
    mode_hints = {
        "explain": (
            "MODE: EXPLAIN. The user wants to understand what a command does. "
            "Reply with a concise explanation (≤50 words) of what the command does, "
            "what each flag means, and what the output shows. NO code block, plain text only."
        ),
        "translate": (
            "MODE: TRANSLATE. The user wants to translate a command from another distro (Ubuntu/Debian/Arch/Fedora) to NixOS. "
            "Reply with the NixOS equivalent command. If there's no direct equivalent, suggest the closest alternative. "
            "Reply ONLY with the raw bash command in a ```code block."
        ),
        "nixos": (
            "MODE: NIXOS. The user is asking about NixOS specifically. "
            "For package installation: use 'nix profile install nixpkgs#<name>' for temporary, "
            "or tell them to add to systemPackages and rebuild. "
            "For rebuild: 'sudo nixos-rebuild switch --flake /etc/nixos#nixos'. "
            "Reply ONLY with the raw bash command in a ```code block."
        ),
    }
    if mode in mode_hints:
        parts.append(mode_hints[mode])
    else:
        parts.append(
            "If the user asks for an action/command: reply ONLY with the raw bash command in a ```code block. "
            "If the user asks a question: reply with plain text, concise, ≤40 words, no code block. "
            "If a command needs sudo, include sudo. "
            "If a command needs a file path, use common sense defaults. "
            "CRITICAL: if you combine MULTIPLE commands in one line, ALWAYS separate them with \" && \" "
            "(e.g. 'lscpu | grep -i vendor && lspci -k | grep -i vga'). Never put two commands "
            "together without an operator."
        )
    if system_ctx:
        parts.append(f"\nSystem state:\n{system_ctx}")
    if history_ctx:
        parts.append(f"\n{history_ctx}")
    return "\n".join(parts)

def build_chain_prompt(user_text, steps_log):
    """Build the prompt for chain continuation."""
    parts = [
        f"Original request: {user_text}",
        "",
        "Steps already done:"
    ]
    for i, s in enumerate(steps_log, 1):
        status = "OK" if s["exit_code"] == 0 else f"FAIL({s['exit_code']})"
        parts.append(f"  Step {i} [{status}]: {s['cmd']}")
        if s["output"].strip():
            parts.append(f"    Output: {s['output'].strip()}")
    parts.append("")
    parts.append(
        "You are chaining commands automatically. "
        "If the task is COMPLETE or you already have a useful result, reply with exactly: DONE <short summary in Spanish>. "
        "Do NOT retry the same command with different flags. "
        "Do NOT keep searching if you already have the answer. "
        "CRITICAL: your DONE summary MUST be based ONLY on the command outputs shown above. "
        "If a piece of data is NOT visible in the outputs, say 'no lo muestra el comando' instead of guessing. "
        "Never invent hardware/specs/versions that are not in the outputs. "
        "If you just CREATED a file (cat >, echo >, tee, etc.), the next step MUST be to EXECUTE or VERIFY it. "
        "If more steps are needed, reply with the NEXT bash command in a ```code block. "
        "Maximum 10 steps total. Be efficient — combine steps when possible."
    )
    return "\n".join(parts)


# ── Providers ───────────────────────────────────────────────────────────────────
def ollama_available():
    try:
        with urllib.request.urlopen(OLLAMA_TAGS, timeout=2) as r:
            data = json.loads(r.read())
    except Exception:
        return False
    models = {m.get("name") or m.get("model") for m in data.get("models", [])}
    if models and OLLAMA_MODEL not in models:
        print(f"{YELLOW}Ollama activo pero no tiene {OLLAMA_MODEL}.{RESET}")
        print(f"  Descárgalo: ollama pull {OLLAMA_MODEL}")
        return False
    return bool(models)

def detect_provider(forced=None):
    global PROVIDER
    if forced:
        PROVIDER = forced.lower()
        print(f"{DIM}Backend: {PROVIDER}{RESET}")
        return
    if ollama_available():
        PROVIDER = "ollama"
        print(f"{DIM}Backend: Ollama local ({OLLAMA_MODEL}){RESET}")
    elif API_KEY.is_file():
        PROVIDER = "deepseek"
        print(f"{DIM}Backend: DeepSeek (sin ollama local){RESET}")
    else:
        print(f"{RED}Error:{RESET} sin Ollama local ni API key de DeepSeek.")
        print(f"  - levanta ollama y baja el modelo: ollama pull {OLLAMA_MODEL}")
        print(f"  - o crea {API_KEY} con tu key de DeepSeek (una línea)")
        sys.exit(1)

def ask_ollama(system_prompt, user_prompt, max_tokens=150, temperature=0.0):
    for attempt in range(2):
        eff_prompt = user_prompt
        if attempt > 0:
            eff_prompt = user_prompt[:400] + "\n\n(No dejaste contenido visible en tu respuesta. Responde directamente ahora, sin pensar en voz alta.)"
        payload = json.dumps({
            "model": OLLAMA_MODEL,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user",   "content": eff_prompt},
            ],
            "stream": False,
            "think": THINK_MODE,
            "options": {"temperature": temperature},
        }).encode()
        req = urllib.request.Request(OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = json.loads(resp.read())
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"Ollama error {e.code}: {e.read().decode(errors='replace')[:200]}")
        except Exception as e:
            raise RuntimeError(f"Ollama sin conexión: {e}")
        content = (data.get("message") or {}).get("content", "").strip()
        if content:
            return content
    raise RuntimeError(f"Ollama devolvió respuesta vacía tras 2 intentos ({OLLAMA_MODEL})")

def ask_deepseek(system_prompt, user_prompt, max_tokens=150, temperature=0.0):
    with open(API_KEY) as f:
        key = f.read().strip()
    for attempt in range(2):
        eff_prompt = user_prompt
        if attempt > 0:
            eff_prompt = user_prompt[:400] + "\n\n(No dejaste contenido visible en tu respuesta. Responde directamente ahora.)"
        payload = json.dumps({
            "model": DEEPSEEK_MODEL,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user",   "content": eff_prompt},
            ],
            "max_tokens": max_tokens,
            "temperature": temperature,
        }).encode()
        req = urllib.request.Request(DEEPSEEK_URL, data=payload, headers={
            "Content-Type":  "application/json",
            "Authorization": f"Bearer {key}",
        })
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                data = json.loads(resp.read())
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")
            raise RuntimeError(f"DeepSeek API error {e.code}: {body[:200]}")
        except Exception as e:
            raise RuntimeError(f"DeepSeek sin conexión (¿se fue la luz?): {e}")
        content = data["choices"][0]["message"]["content"].strip()
        if content:
            return content
    raise RuntimeError("DeepSeek devolvió respuesta vacía tras 2 intentos")

def ask(system_prompt, user_prompt, max_tokens=150, temperature=0.0):
    """Intenta el provider activo; si falla, hace fallback al otro (offline = local)."""
    order = [PROVIDER] + [p for p in ("ollama", "deepseek") if p != PROVIDER]
    last_err = ""
    for attempt, p in enumerate(order):
        try:
            if p == "ollama":
                return ask_ollama(system_prompt, user_prompt, max_tokens, temperature)
            return ask_deepseek(system_prompt, user_prompt, max_tokens, temperature)
        except RuntimeError as e:
            last_err = str(e)
            print(f"{YELLOW}⚠ {last_err}{RESET}")
            if p == "deepseek":
                print(f"  Sin internet?→ pasando a Ollama local (offline OK)...")
            else:
                print(f"  Ollama caído → pasando a DeepSeek...")
    print(f"{RED}Error:{RESET} ambos backends fallaron.")
    print(f"  {last_err}")
    sys.exit(1)


# ── Parse ─────────────────────────────────────────────────────────────────────
def fix_missing_seps(cmd):
    """Insert '&&' between glued commands (e.g. 'lscpu ... lspci ...'). Generoso,
    pero la confirmacion [Y/n] deja ver el resultado antes de ejecutar."""
    if not cmd:
        return cmd
    strong = ("lscpu", "lspci", "systemctl", "journalctl", "nmcli", "bluetoothctl",
              "hyprctl", "uname", "hostnamectl", "lsblk", "mount", "sensors", "uptime",
              "free", "df", "ps", "ping", "ss", "ip", "top", "which", "find",
              "apt", "apt-get", "dnf", "pacman", "curl", "wget", "git", "ls", "cat",
              "grep", "head", "tail", "neofetch", "fastfetch", "nvidia-smi",
              "sudo")
    pat = r"(?<=[^\s&|;<>])\s+(?=(?:" + "|".join(
        sorted(strong, key=len, reverse=True)) + r")(?=\s|\||$))"
    cmd = re.sub(pat, " && ", cmd)
    return re.sub(r"\s*&&\s+(?:&&\s+)+", " && ", cmd).strip()


def parse(text):
    """Extract command from AI response (thinking prose makes it tolerant)."""
    if "```" in text:
        parts = text.split("```")
        for i in range(len(parts) - 2, 0, -2):
            block = parts[i].strip()
            if not block:
                continue
            first = block.split()[0] if block.split() else ""
            if first in ("bash", "sh", "cmd", "shell", "zsh"):
                block = " ".join(block.split()[1:])
            if block.split():
                return ("cmd", fix_missing_seps(block))
    # No fenced command — check if it starts with a known command word
    stripped = text.strip()
    cmd_starters = ("sudo", "nix", "apt", "dnf", "curl", "wget",
                    "git", "python", "node", "bash", "mkdir", "cp", "mv", "rm",
                    "ls", "cat", "echo", "printf", "chmod", "ps", "kill",
                    "systemctl", "journalctl", "nmcli", "bluetoothctl", "hyprctl",
                    "df", "du", "free", "find", "grep", "tar", "wc", "sort",
                    "head", "tail", "ping", "ss", "ip", "wpctl", "pactl")
    first_word = stripped.split()[0] if stripped.split() else ""
    if first_word in cmd_starters:
        return ("cmd", fix_missing_seps(stripped))
    return ("text", text)


# ── Dev agent (mini-opencode) ──────────────────────────────────────────────
DEV_PROMPT = (
    "Eres un desarrollador senior trabajando en la terminal sobre este proyecto.\n"
    "Puedes editar código real. Protocolo de acciones (una línea por acción, empieza con #):\n"
    "  #READ <ruta>          leer un archivo (ruta relativa al cwd)\n"
    "  #LIST <ruta>          listar un directorio\n"
    "  #RUN <comando>        ejecutar un comando bash\n"
    "  #WRITE <ruta>         seguido de todo el contenido del archivo: crearlo o reemplazarlo COMPLETO\n"
    "Cuando termines la tarea: #DONE <resumen corto en español>\n"
    "Reglas: explora con LIST si no conoces la estructura; lee con READ antes de editar; "
    "edita lo mínimo posible; verifica con RUN cuando convenga; NO inventes rutas; "
    "JAMÁS uses #RUN para abrir editores ni apps gráficas (code, firefox, etc.). "
    "Siempre responde con una acción hasta completar la tarea."
)

ACTION_RE = re.compile(r"^#(READ|LIST|RUN|WRITE|DONE)\s*(.*)$", re.I)

def truncate(s, n):
    return s if len(s) <= n else s[:n] + f"\n… [truncado {len(s)-n} chars]"

def load_file_context(paths):
    parts = []
    for p in paths:
        fp = Path(p)
        if not fp.is_file():
            print(f"{YELLOW}⚠ no existe: {p}{RESET}")
            continue
        try:
            txt = fp.read_text(errors="replace")
        except Exception as e:
            print(f"{YELLOW}⚠ no pude leer {p}: {e}{RESET}")
            continue
        parts.append(f"── Archivo: {p} ──\n{txt}")
        total = sum(len(x) for x in parts)
        if total > 60000:
            parts.pop()
            print(f"{YELLOW}⚠ contexto de archivos limitado a 60k chars.{RESET}")
            break
    return "\n\n".join(parts) if parts else ""

def repo_tree(max_entries=80):
    try:
        r = subprocess.run(["git", "ls-files"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            files = [l for l in r.stdout.splitlines() if l.strip() and "/.git" not in l]
            shown = files if len(files) <= max_entries else files[:max_entries]
            return "git ls-files:\n" + "\n".join(shown) + (f"\n… ({len(files)} archivos totales)" if len(files) > max_entries else "")
    except Exception:
        pass
    lines = []
    root = Path(os.getcwd())
    for p in sorted(root.rglob("*")):
        if any(part.startswith(".") for part in p.parts):
            continue
        if p.is_file():
            lines.append(str(p.relative_to(root)))
        if len(lines) >= max_entries:
            break
    return "archivos del proyecto:\n" + ("\n".join(lines) if lines else "(vacío)")

def git_status_snapshot():
    try:
        r = subprocess.run(["git", "status", "--short", "--branch"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip() if r.stdout.strip() else ""
    except Exception:
        return ""

def parse_actions(text):
    """Devuelve (list[(kind,arg,content)], summary). WRITE acumula contenido hasta la próxima acción."""
    actions, summary = [], ""
    cur_write, write_buf = None, []
    for line in text.replace("\r", "").split("\n"):
        m = ACTION_RE.match(line.strip())
        if m:
            kind, arg = m.group(1).upper(), m.group(2).strip()
            if cur_write:
                actions.append(("WRITE", cur_write, "\n".join(write_buf).rstrip("\n")))
                cur_write, write_buf = None, []
            if kind == "DONE":
                summary = arg or "listo"
                break
            if kind in ("READ", "LIST", "RUN") and arg:
                actions.append((kind, arg, ""))
            elif kind == "WRITE" and arg:
                cur_write = arg
            continue
        if cur_write is not None:
            write_buf.append(line)
        else:
            m2 = re.search(r"\bDONE\b\s*(.*)", line, re.I)
            if m2 and not summary:
                summary = m2.group(1).strip()
    if cur_write:
        actions.append(("WRITE", cur_write, "\n".join(write_buf).rstrip("\n")))
    return actions, summary

def exec_dev_action(kind, arg, content, dry_run=False):
    """Ejecuta acción del agente. Devuelve (hecho, texto_respuesta)."""
    if kind in ("READ", "LIST"):
        p = Path(arg)
        if not p.exists():
            return True, f"[{kind} {arg}] no existe"
        if kind == "LIST" or p.is_dir():
            entries = sorted(os.listdir(p))
            return True, f"[LIST {arg}]\n" + ("\n".join(entries[:100]) or "(vacío)")
        try:
            txt = p.read_text(errors="replace")
        except Exception as e:
            return True, f"[READ {arg}] error: {e}"
        return True, f"[READ {arg}]\n" + truncate(txt, MAX_READ_CHARS)
    if kind == "RUN":
        if dry_run:
            return True, f"[RUN {arg}] (dry-run, no se ejecutó)"
        if not confirm_exec(arg):
            return True, f"[RUN {arg}] cancelado por el usuario"
        exit_code, output, blocked = safe_run_cmd(arg, silent=True)
        if blocked:
            return False, f"[RUN {arg}] ⛔ bloqueado por seguridad"
        return True, f"[RUN {arg}] exit={exit_code}\n" + truncate(output.strip(), 4000)
    if kind == "WRITE":
        if dry_run:
            return True, f"[WRITE {arg}] (dry-run) no se escribió ({len(content)} chars de contenido)"
        if not content.strip():
            return True, f"[WRITE {arg}] vacío — omitido"
        fp = Path(arg)
        fp.parent.mkdir(parents=True, exist_ok=True)
        fp.write_text(content)
        return True, f"[WRITE {arg}] escrito ({len(content)} chars)"
    return False, ""

def dev_agent(task, files_ctx, max_steps=MAX_DEV_STEPS, dry_run=False):
    tree = repo_tree()
    git = git_status_snapshot()
    ctx = []
    if git:
        ctx.append("Git status:\n" + git)
    ctx.append(tree)
    if files_ctx:
        ctx.append(files_ctx)
    system = DEV_PROMPT + "\n\nEstado del proyecto:\n" + "\n".join(ctx)
    convo = f"Tarea: {task}\n\nEscribe TU PRIMERA acción (#READ/#LIST/#RUN/#WRITE)."
    prev_sig = None
    repeat_count = 0
    sig_counts = {}
    has_write = False
    for step in range(1, max_steps + 1):
        print(f"── Paso {step}/{max_steps} ──")
        raw = ask(system, convo, max_tokens=700)
        print(f"  nini: {DIM}{raw}{RESET}")
        actions, done = parse_actions(raw)
        results = []
        got_action = False
        for kind, arg, content in actions:
            did, resp = exec_dev_action(kind, arg, content, dry_run)
            got_action = got_action or did
            results.append(resp)
            if kind == "WRITE" and did:
                has_write = True
        sig = "|".join(f"{k}:{a}" for k, a, _ in actions)
        sig_counts[sig] = sig_counts.get(sig, 0) + 1
        if sig_counts[sig] >= 3:
            print(f"\n{YELLOW}⚠ repetición: nini está ciclando entre las mismas acciones.{RESET}")
            print(f"  Sugerencias: pide la tarea más concreta, o usa --api deepseek para más inteligencia.")
            save_history(task, f"[dev bucle en paso {step}]", -1)
            return step, "bucle detectado"
        if sig == prev_sig and sig:
            repeat_count += 1
        else:
            repeat_count = 0
        prev_sig = sig
        if repeat_count >= 2:
            print(f"\n{YELLOW}⚠ repetición: nini se quedó dando la misma acción.{RESET}")
            print(f"  Sugerencias: pide la tarea más concreta, o usa --api deepseek para más inteligencia.")
            save_history(task, f"[dev bucle en paso {step}]", -1)
            return step, "bucle detectado"
        if done and not got_action:
            print(f"\n{GREEN}✅ {done}{RESET}")
            save_history(task, f"[dev {step} paso(s)]", 0, done[:100])
            return step, done
        if not got_action and not results:
            text = raw.strip()
            if done:
                print(f"\n{GREEN}✅ {done}{RESET}")
            else:
                print(f"{YELLOW}⚠ modelo sin acciones:{RESET} {text[:200]}")
            save_history(task, f"[dev {step} paso(s)]", 0, (done or text)[:100])
            return step, (done or text)
        results_txt = "\n\n".join([r for r in results if r])
        if done:
            if results_txt:
                print(f"\n{DIM}{results_txt}{RESET}")
            print(f"\n{GREEN}✅ {done}{RESET}")
            save_history(task, f"[dev {step} paso(s)]", 0, done[:100])
            return step, done
        convo = (f"Tarea original: {task}\n\n"
                 f"Resultados de tus acciones:\n{results_txt}\n\n"
                 f"Continúa: da la siguiente acción para completar la tarea, "
                 f"o responde #DONE <resumen> si ya terminó.")
        if step >= 3 and not has_write:
            convo += ("\n\nNota del asistente: llevas varios pasos sin modificar nada "
                      "(solo READ/LIST/RUN). Si el diagnóstico ya basta, responde #DONE. "
                      "Si necesitas cambiar algo, usa #WRITE. NO repitas comandos de diagnóstico ya ejecutados.")
        if len(convo) > MAX_CONVO_CHARS:
            convo = convo[:MAX_CONVO_CHARS] + "\n… [contexto limitado]"
    print(f"\n{YELLOW}⚠ Máximo de pasos ({max_steps}) alcanzado.{RESET}")
    save_history(task, f"[dev {max_steps} paso(s), max]", 0)
    return max_steps, f"Pasos agotados ({max_steps})."


# ── Run command (silent mode for chain) ──────────────────────────────────────
def run_cmd(cmd, silent=False):
    """Run a bash command. Returns (exit_code, output)."""
    if not silent:
        print(f"\n  $ {cmd[:120]}{'...' if len(cmd) > 120 else ''}")
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60)
    output = r.stdout + r.stderr
    if not silent and output.strip():
        for line in output.strip().split("\n"):
            print(f"  {line}")
    return r.returncode, output


def confirm_exec(cmd):
    print(f"  $ {cmd}")
    if YES_MODE:
        return True
    ans = input(f"  ¿Ejecutar? [Y/n] ").strip().lower()
    return ans in ("", "y", "s", "si", "sí")


def safe_run_cmd(cmd, silent=False):
    """Run command with safety check. Returns (exit_code, output, blocked)."""
    first = cmd.split()[0] if cmd.split() else ""
    if first in DENY_RUN:
        print(f"\n  {RED}⛔ '{first}' es una app gráfica; nini no la abre.{RESET}")
        print(f"  Ábrela tú mismo: {cmd}")
        return -1, "App gráfica bloqueada", True
    safe, warning = check_heavy_command(cmd)
    if not safe:
        is_destructive = warning.startswith("DESTRUCTIVO:")
        if is_destructive:
            print(f"\n  {RED}⛔ BLOQUEADO: {warning}{RESET}")
            print(f"  Comando: {cmd}")
            return -1, "Comando destructivo bloqueado", True
        else:
            print(f"\n  {YELLOW}⚠ ADVERTENCIA: {warning}{RESET}")
            print(f"  Comando: {cmd}")
            if not YES_MODE and input(f"  ¿Ejecutar? [y/N] ").strip().lower() not in ("y", "s", "si", "sí"):
                return -1, "Bloqueado por seguridad", True
    exit_code, output = run_cmd(cmd, silent=silent)
    return exit_code, output, False


# ── Error recovery (single command mode) ─────────────────────────────────────
def run_with_recovery(cmd, user_prompt, system_prompt):
    print(f"\n  $ {cmd}\n")
    ans = input(f"  ¿Ejecutar? [Y/n] ").strip().lower()
    if not YES_MODE and ans not in ("", "y", "s", "si", "sí"):
        print(f"  Cancelado.")
        return None

    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60)
    output = r.stdout + r.stderr
    if r.returncode != 0 and output.strip():
        print(f"{RED}  Exit code: {r.returncode}{RESET}")
        for line in output.strip().split("\n"):
            print(f"  {line}")
        fix_prompt = (
            f"The command failed with exit code {r.returncode}.\n"
            f"Command: {cmd}\n"
            f"Error output: {output.strip()}\n"
            f"Original request: {user_prompt}\n"
            f"Suggest a fix. Reply ONLY with the corrected bash command in a ```code block."
        )
        print(f"\n  Intentando corregir...")
        raw_fix = ask(system_prompt, fix_prompt, max_tokens=150)
        kind, fixed_cmd = parse(raw_fix)
        if kind == "cmd" and fixed_cmd != cmd:
            print(f"\n  Fix: {fixed_cmd}\n")
            ans2 = input(f"  ¿Ejecutar el fix? [Y/n] ").strip().lower()
            if YES_MODE or ans2 in ("", "y", "s", "si", "sí"):
                r2 = subprocess.run(fixed_cmd, shell=True, capture_output=True, text=True, timeout=60)
                out2 = (r2.stdout + r2.stderr).strip()
                if out2:
                    for line in out2.split("\n"):
                        print(f"  {line}")
                return r2.returncode
        return r.returncode
    else:
        if output.strip():
            for line in output.strip().split("\n"):
                print(f"  {line}")
    return r.returncode


# ── Auto-chain engine ────────────────────────────────────────────────────────
def auto_chain(user_text, system_prompt, max_steps=MAX_STEPS):
    """Run up to max_steps commands automatically."""
    steps_log = []
    current_prompt = user_text

    print(f"  Chain: máx {max_steps} pasos\n")

    for step in range(1, max_steps + 1):
        print(f"── Paso {step}/{max_steps} ──")

        # Ask AI for next step
        raw = ask(system_prompt, current_prompt, max_tokens=150)
        kind, content = parse(raw)

        # Check if DONE
        if kind == "text" and content.upper().startswith("DONE"):
            summary = content[4:].strip() if len(content) > 4 else "Tarea completada."
            print(f"\n{GREEN}✅ {summary}{RESET}")
            return steps_log, summary

        if kind != "cmd":
            # AI answered with text, task might be done
            print(f"\n{GREEN}✅ {content}{RESET}")
            return steps_log, content

        # Check command exists
        cmd_name = content.split()[0]
        if cmd_name and cmd_name not in ("sudo", "nohup", "time", "env", "bash"):
            if not subprocess.run(["which", cmd_name], capture_output=True).returncode == 0:
                print(f"{RED}⚠ '{cmd_name}' no está instalado. Deteniendo.{RESET}")
                break

        # Execute with safety check
        exit_code, output, blocked = safe_run_cmd(content, silent=False)
        if blocked:
            break

        # Log step
        steps_log.append({
            "step": step,
            "cmd": content,
            "exit_code": exit_code,
            "output": output,
        })

        # If command failed, try recovery
        if exit_code != 0 and output.strip():
            print(f"{RED}  Exit code: {exit_code}{RESET}")
            fix_prompt = (
                f"Command failed (exit {exit_code}):\n{content}\n"
                f"Error: {output.strip()}\n"
                f"Suggest a fix in a ```code block, or reply DONE if unrecoverable."
            )
            raw_fix = ask(system_prompt, fix_prompt, max_tokens=150)
            kind_fix, fixed_cmd = parse(raw_fix)
            if kind_fix == "cmd" and fixed_cmd != content:
                print(f"  Fix: {fixed_cmd}")
                exit_code2, output2, _ = safe_run_cmd(fixed_cmd, silent=False)
                steps_log[-1]["fix"] = fixed_cmd
                steps_log[-1]["fix_exit"] = exit_code2

        # Build next prompt with context
        current_prompt = build_chain_prompt(user_text, steps_log)

    # Reached max steps
    print(f"\n{YELLOW}⚠ Máximo de pasos alcanzado ({max_steps}){RESET}")
    return steps_log, f"Ejecutados {len(steps_log)} pasos."


# ── Main ──────────────────────────────────────────────────────────────────────
HELP_TEXT = f"""{BOLD}nini{RESET} v4 — asistente terminal (Ollama local + DeepSeek respaldo)

{BOLD}Backend (automático):{RESET}
  - Si Ollama local responde  -> usa qwen3:8b (offline, gratis, sin key)
  - Si no -> usa DeepSeek (key en {API_KEY.name})
  - Si DeepSeek falla (sin internet) -> cae automatico a Ollama local
  Fuerza uno: --api ollama | --api deepseek
  Razonamiento (pensamiento) activado SIEMPRE; --nothink para respuestas
  rápidas y directas (útil para comandos simples).

{BOLD}Uso:{RESET}
  nini <pregunta u orden>            consulta sistema / comando (auto-chain)
  nini dev "<tarea de código>"       MODE DEV: lee/lista/ejecuta/escribe archivos
                                     iterando hasta completar (mini-opencode)
  echo "texto" | nini <procesar>     (pipe)
  nini -f <archivo> <pregunta>       agrega contenido de archivo al contexto
  nini --dry-run <orden>             mostrar sin ejecutar
  nini --yes <orden>                 ejecutar sin preguntar (scripts)
  nini --steps N <orden>             máx N pasos, default 10
  nini help                          (esta ayuda)

{BOLD}Modos dev:{RESET}
  #READ <ruta>   #LIST <ruta>  #RUN <comando>  #WRITE <ruta> (+ contenido)
  El agente explora el proyecto y edita archivos, verificando con git status.

{BOLD}Ejemplos:{RESET}
  nini ¿cuánto espacio tengo en disco?
  nini instala firefox
  nini dev "agrega una bandera --verbose al script main.py"
  nini -f ~/.config/hypr/hyprland.lua "revisa mis binds"
  cat log.txt | nini resume esto
  nini --dry-run borra /tmp/ viejos
"""


def main():
    global THINK_MODE, OLLAMA_MODEL, YES_MODE
    # --help
    if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    # Parse flags
    dry_run = False
    no_chain = False
    max_steps = MAX_STEPS
    dev_steps = MAX_DEV_STEPS
    api_forced = None
    model_override = None
    file_args = []
    args = sys.argv[1:]

    # Pre-process flags (remain after removal)
    for flag in ["--dry-run", "--no-chain"]:
        if flag in args:
            if flag == "--dry-run": dry_run = True
            if flag == "--no-chain": no_chain = True
            args.remove(flag)
    if "--smart" in args:
        THINK_MODE = True
        args.remove("--smart")
    if "--nothink" in args:
        THINK_MODE = False
        args.remove("--nothink")
    if "--yes" in args:
        YES_MODE = True
        args.remove("--yes")
    for flag in ["--api", "--model", "-f", "--file", "--steps", "--dev-steps"]:
        while flag in args:
            idx = args.index(flag)
            if idx + 1 < len(args):
                val = args.pop(idx + 1)
                if flag in ("-f", "--file"):
                    file_args.append(val)
                elif flag == "--api":
                    api_forced = val
                elif flag == "--model":
                    model_override = val
                elif flag == "--steps":
                    try: max_steps = min(int(val), MAX_STEPS)
                    except ValueError: pass
                elif flag == "--dev-steps":
                    try: dev_steps = min(int(val), MAX_DEV_STEPS)
                    except ValueError: pass
            args.pop(idx)

    if model_override:
        global OLLAMA_MODEL
        OLLAMA_MODEL = model_override

    # Pipe support
    pipe_input = ""
    if not sys.stdin.isatty():
        pipe_input = sys.stdin.read().strip()

    if not args and not pipe_input:
        print(HELP_TEXT)
        sys.exit(0)

    user_text = " ".join(args)
    if pipe_input:
        user_text = f"Input from pipe:\n{pipe_input}\n\nUser request: {user_text}"

    # Detect backend provider (ollama / deepseek)
    detect_provider(api_forced)

    # File context (-f / --file)
    files_ctx = load_file_context(file_args) if file_args else ""

    # ── Modo DEV (mini-opencode) ──
    is_dev = False
    task_text = user_text
    if user_text.startswith("dev ") or user_text.startswith('dev "') or user_text.startswith("dev '"):
        is_dev = True
        task_text = re.sub(r'^dev\s+', '', user_text)
    elif "--dev" in args:
        is_dev = True
        task_text = re.sub(r'--dev\s*', '', user_text)
    if is_dev:
        if PROVIDER == "ollama":
            print(f"{DIM}Ojo: el modelo local es limitado como agente. Para tareas de código reales usa --api deepseek.{RESET}")
        step, summary = dev_agent(task_text, files_ctx, dev_steps, dry_run)
        return

    # Detect mode (explain / translate / nixos / default)
    mode = detect_mode(user_text)

    # System context
    sys_ctx = get_system_context()

    # History
    hist_entries = load_history(n=5)
    hist_ctx = format_history(hist_entries)

    # Build system prompt (+ optional file context)
    system_prompt = build_system_prompt(mode, sys_ctx, hist_ctx)
    if files_ctx:
        system_prompt += f"\n\nArchivos seleccionados:\n{files_ctx}"

    # ── Explain / Translate / NixOS modes → single shot (no chain) ──
    if mode in ("explain", "translate", "nixos") or no_chain:
        tokens = 300
        raw = ask(system_prompt, user_text, max_tokens=tokens)
        kind, content = parse(raw)

        if not content.strip():
            print(f"{YELLOW}⚠ el modelo respondió vacío; reintenta.{RESET}")
            return

        if kind == "cmd":
            if dry_run:
                print(f"\n  Dry run: {content}\n")
                sys.exit(0)
            cmd_name = content.split()[0]
            if cmd_name and cmd_name not in ("sudo", "nohup", "time", "env", "bash"):
                if not subprocess.run(["which", cmd_name], capture_output=True).returncode == 0:
                    print(f"{RED}⚠ '{cmd_name}' no está instalado.{RESET}")
                    print(f"  Instálalo con: nix profile install nixpkgs#{cmd_name}")
                    sys.exit(1)
            exit_code = run_with_recovery(content, user_text, system_prompt)
            save_history(user_text, content, exit_code or 0)
        else:
            print(f"\n{content}\n")
            save_history(user_text, "[text response]", 0, content[:100])
        return

    # ── Default mode → auto-chain ──
    # First, check if AI thinks this is a question (text) or action (cmd)
    raw = ask(system_prompt, user_text, max_tokens=300)
    kind, content = parse(raw)

    if not content.strip():
        print(f"{YELLOW}⚠ el modelo respondió vacío; reintenta o usa --api deepseek.{RESET}")
        return

    if kind == "text":
        # It's a question, just answer
        print(f"\n{content}\n")
        save_history(user_text, "[text response]", 0, content[:100])
        return

    if kind == "cmd" and re.search(r"\bcomando\b|command\b|qu[eé] comando", user_text, re.I):
        print(f"\nEl comando sería:\n  {BOLD}{content}{RESET}\n")
        save_history(user_text, content, 0)
        return

    # It's a command — run auto-chain
    if dry_run:
        print(f"\n  Dry run (step 1): {content}\n")
        # Show what chain would do
        steps_preview = [content]
        preview_prompt = build_chain_prompt(user_text, [{"step": 1, "cmd": content, "exit_code": 0, "output": ""}])
        for _ in range(min(max_steps - 1, 4)):  # Preview up to 5 steps
            raw_p = ask(system_prompt, preview_prompt, max_tokens=150)
            kind_p, content_p = parse(raw_p)
            if kind_p == "text" and content_p.upper().startswith("DONE"):
                break
            if kind_p == "cmd":
                steps_preview.append(content_p)
                preview_prompt = build_chain_prompt(user_text, [
                    {"step": i+1, "cmd": c, "exit_code": 0, "output": ""}
                    for i, c in enumerate(steps_preview)
                ])
        print(f"Secuencia completa ({len(steps_preview)} pasos):")
        for i, s in enumerate(steps_preview, 1):
            print(f"  {i}. {s}")
        print()
        return

    # Execute first command with safety check
    print(f"\n── Paso 1/{max_steps} ──")
    if not confirm_exec(content):
        save_history(user_text, content, -1)
        return
    exit_code, output, blocked = safe_run_cmd(content, silent=True)
    if blocked:
        save_history(user_text, content, -1)
        return

    steps_log = [{
        "step": 1,
        "cmd": content,
        "exit_code": exit_code,
        "output": output,
    }]

    # If first command failed, try recovery
    if exit_code != 0 and output.strip():
        print(f"{RED}  Exit code: {exit_code}{RESET}")
        fix_prompt = (
            f"Command failed (exit {exit_code}):\n{content}\n"
            f"Error: {output.strip()}\n"
            f"Suggest a fix in a ```code block, or reply DONE if unrecoverable."
        )
        raw_fix = ask(system_prompt, fix_prompt, max_tokens=150)
        kind_fix, fixed_cmd = parse(raw_fix)
        if kind_fix == "cmd" and fixed_cmd != content:
            print(f"  Fix: {fixed_cmd}")
            if confirm_exec(fixed_cmd):
                exit_code2, output2, _ = safe_run_cmd(fixed_cmd, silent=True)
                steps_log[-1]["fix"] = fixed_cmd
                steps_log[-1]["fix_exit"] = exit_code2

    # Chain continuation
    current_prompt = build_chain_prompt(user_text, steps_log)

    for step in range(2, max_steps + 1):
        print(f"\n── Paso {step}/{max_steps} ──")

        raw = ask(system_prompt, current_prompt, max_tokens=150)
        kind, content = parse(raw)

        # Check if DONE
        if kind == "text":
            summary = content
            if content.upper().startswith("DONE"):
                summary = content[4:].strip() if len(content) > 4 else "Tarea completada."
            print(f"\n{GREEN}✅ {summary}{RESET}")
            save_history(user_text, f"[{len(steps_log)} steps]", 0, summary[:100])
            return

        if kind != "cmd":
            print(f"\n{GREEN}✅ {content}{RESET}")
            save_history(user_text, f"[{len(steps_log)} steps]", 0, content[:100])
            return

        # Check command exists
        cmd_name = content.split()[0]
        if cmd_name and cmd_name not in ("sudo", "nohup", "time", "env", "bash"):
            if not subprocess.run(["which", cmd_name], capture_output=True).returncode == 0:
                print(f"{RED}⚠ '{cmd_name}' no está instalado. Deteniendo.{RESET}")
                break

        # Prevent duplicate commands (same base command)
        base_cmd = content.split()[0] if content.split() else ""
        prev_bases = [s["cmd"].split()[0] for s in steps_log if s["cmd"].split()]
        if base_cmd in prev_bases and "--" not in content:
            print(f"\n{GREEN}✅ (respuesta ya obtenida en pasos anteriores){RESET}")
            save_history(user_text, f"[{len(steps_log)} steps, dedup]", 0)
            return

        # Execute with safety check
        if not confirm_exec(content):
            print(f"{DIM}  Cancelado en paso {step}.{RESET}")
            break
        exit_code, output, blocked = safe_run_cmd(content, silent=True)
        if blocked:
            break

        steps_log.append({
            "step": step,
            "cmd": content,
            "exit_code": exit_code,
            "output": output,
        })

        # Recovery on failure
        if exit_code != 0 and output.strip():
            print(f"{RED}  Exit code: {exit_code}{RESET}")
            fix_prompt = (
                f"Command failed (exit {exit_code}):\n{content}\n"
                f"Error: {output.strip()}\n"
                f"Suggest a fix in a ```code block, or reply DONE if unrecoverable."
            )
            raw_fix = ask(system_prompt, fix_prompt, max_tokens=150)
            kind_fix, fixed_cmd = parse(raw_fix)
            if kind_fix == "cmd" and fixed_cmd != content:
                print(f"  Fix: {fixed_cmd}")
                if confirm_exec(fixed_cmd):
                    exit_code2, output2, _ = safe_run_cmd(fixed_cmd, silent=True)
                    steps_log[-1]["fix"] = fixed_cmd
                    steps_log[-1]["fix_exit"] = exit_code2

        # Update chain prompt
        current_prompt = build_chain_prompt(user_text, steps_log)

    # Max steps reached
    print(f"\n{YELLOW}⚠ Máximo de pasos alcanzado ({max_steps}){RESET}")
    save_history(user_text, f"[{len(steps_log)} steps, max reached]", 0)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n\n{DIM}Cancelado (Ctrl+C){RESET}")
        sys.exit(130)
    except BrokenPipeError:
        print()
        sys.exit(0)
